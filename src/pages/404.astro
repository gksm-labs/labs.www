---
import Layout from "../layouts/Layout.astro";

const pathname = Astro.url.pathname ?? "";
const lang = pathname.startsWith("/en/")
  ? "en"
  : pathname.startsWith("/sk/")
    ? "sk"
    : "sk";

const t = {
  sk: {
    title: "Stránka nenájdená – 404",
    description: "Táto stránka neexistuje alebo bola presunutá.",
    h1: "404",
    heading: "Stránka nenájdená",
    text: "Ospravedlňujeme sa, požadovaná stránka neexistuje alebo bola presunutá.",
    back: "Naspäť na úvodnú stránku",
    backLink: "/",
  },
  en: {
    title: "Page Not Found – 404",
    description: "This page either does not exist or has been moved.",
    h1: "404",
    heading: "Page Not Found",
    text: "Sorry, the page you are looking for does not exist or has been moved.",
    back: "Back to homepage",
    backLink: "/en/",
  },
}[lang];
---

<Layout lang={lang} title={t.title} description={t.description} noIndexNoFollow>
  <main>
    <section
      class="mx-auto flex max-w-4xl flex-col items-center justify-center px-4 py-24"
    >
      <h1 class="mb-4 text-center text-5xl font-bold text-zinc-900">{t.h1}</h1>
      <h2 class="mb-2 text-center text-2xl font-semibold text-zinc-700">
        {t.heading}
      </h2>
      <p class="mb-8 max-w-md text-center text-base text-zinc-500">
        {t.text}
      </p>
      <a
        href={t.backLink}
        class="text-base font-semibold text-amber-700 transition-colors hover:text-amber-800"
      >
        {t.back}
      </a>
    </section>
  </main>
</Layout>
