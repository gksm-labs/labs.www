---
import Layout from "../layouts/Layout.astro";
import Project from "../components/projects/Project";
import { translation } from "../i18n/translation";

const projects = translation["sk"].projects;
---

<Layout lang="sk">
  <Fragment slot="head">
    <meta
      name="description"
      content="Objav projekty študentskej organizácie GKŠM Labs na Gymnáziu Karola Štúra v Modre. Pozri si našu inovatívnu prácu v IT, dizajne a komunite."
    />
    <meta name="author" content="Peter Packa" />
    <meta
      name="keywords"
      content="GKŠM Labs, projekty, študenti, Modra, organizácia, inovácie, programovanie, dizajn, Gymnázium Karola Štúra, komunita, IT, vývoj, technológie"
    />
    <meta name="robots" content="index, follow" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content="Projekty | GKŠM Labs" />
    <meta
      property="og:description"
      content="Objav projekty študentov GKŠM Labs na Gymnáziu Karola Štúra v Modre. Inovatívna práca v IT, dizajne a komunite."
    />
    <meta property="og:url" content="https://labs.gksm.sk/projekty" />
    <meta property="og:site_name" content="GKŠM Labs" />
    <meta property="og:locale" content="sk_SK" />

    <link rel="canonical" href="https://labs.gksm.sk/projekty" />
    <link rel="alternate" href="https://labs.gksm.sk/projekty" hreflang="sk" />
    <link
      rel="alternate"
      href="https://labs.gksm.sk/en/projects"
      hreflang="en"
    />

    <title>Projekty | GKŠM Labs</title>
  </Fragment>
  <main class="mt-26 min-h-screen">
    <section class="mx-auto max-w-5xl px-4 py-12">
      <h1
        class="mb-10 text-center text-4xl font-black underline decoration-amber-400 decoration-wavy"
      >
        Projekty
      </h1>
      <div class="flex flex-col gap-25">
        {
          projects.length === 0 ? (
            <h2 class="py-10 text-center text-xl">
              Žiadne aktuálne projekty neboli nájdené
            </h2>
          ) : (
            projects.map((project) => (
              <Project
                client:load
                lang="sk"
                pathname={Astro.url.pathname}
                project={project}
              />
            ))
          )
        }
      </div>
    </section>
  </main>
</Layout>
