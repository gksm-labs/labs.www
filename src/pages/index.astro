---
import Layout from "../layouts/Layout.astro";
---

<Layout>
    <main
        class="min-h-screen bg-white text-zinc-900 flex items-center justify-center px-6 md:px-12 font-sans selection:bg-amber-200 selection:text-zinc-900"
    >
        <div
            class="flex flex-col md:flex-row items-center gap-12 md:gap-24 max-w-6xl mx-auto w-full"
        >
            <div class="relative shrink-0 flex items-center justify-center">
                <div
                    class="absolute inset-0 bg-amber-200/50 blur-[60px] rounded-full w-full h-full transform scale-75"
                >
                </div>

                <svg
                    class="w-56 h-56 md:w-80 md:h-80 text-zinc-900 relative z-10"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="0.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    xmlns="http://www.w3.org/2000/svg"
                >
                    <defs>
                        <!-- Masking the liquid to stay inside the flask outline -->
                        <clipPath id="flask-clip">
                            <path
                                d="M9 2v6.5L3.8 19.3A2 2 0 0 0 5.6 22h12.8a2 2 0 0 0 1.8-2.7L15 8.5V2"
                            ></path>
                        </clipPath>
                    </defs>

                    <!-- Animated Liquid & Bubbles -->
                    <g clip-path="url(#flask-clip)">
                        <!-- Yellow liquid base -->
                        <rect
                            x="-5"
                            y="11"
                            width="34"
                            height="15"
                            fill="#fbbf24"
                            stroke="none"
                            class="animate-liquid"></rect>

                        <!-- Rising Bubbles -->
                        <circle
                            cx="8"
                            cy="22"
                            r="1.5"
                            fill="white"
                            stroke="none"
                            class="bubble"
                            style="animation-delay: 0s;"></circle>
                        <circle
                            cx="15"
                            cy="22"
                            r="1"
                            fill="white"
                            stroke="none"
                            class="bubble"
                            style="animation-delay: 0.7s;"></circle>
                        <circle
                            cx="11"
                            cy="22"
                            r="2"
                            fill="white"
                            stroke="none"
                            class="bubble"
                            style="animation-delay: 1.4s;"></circle>
                        <circle
                            cx="17"
                            cy="22"
                            r="1.2"
                            fill="white"
                            stroke="none"
                            class="bubble"
                            style="animation-delay: 2.1s;"></circle>
                        <circle
                            cx="6"
                            cy="22"
                            r="1.8"
                            fill="white"
                            stroke="none"
                            class="bubble"
                            style="animation-delay: 0.4s;"></circle>
                        <circle
                            cx="13"
                            cy="22"
                            r="0.8"
                            fill="white"
                            stroke="none"
                            class="bubble"
                            style="animation-delay: 1.1s;"></circle>
                    </g>

                    <path
                        d="M9 2v6.5L3.8 19.3A2 2 0 0 0 5.6 22h12.8a2 2 0 0 0 1.8-2.7L15 8.5V2"
                    ></path>
                    <path d="M8 2h8"></path>
                    <path d="M6 16h12"></path>
                </svg>
            </div>

            <div
                class="text-center md:text-left flex flex-col items-center md:items-start"
            >
                <h1
                    class="text-6xl md:text-8xl lg:text-[7.5rem] font-black tracking-tighter text-zinc-900 leading-none mb-6"
                >
                    GKŠM Labs
                </h1>

                <p
                    class="text-2xl md:text-4xl text-zinc-400 font-medium mb-12 tracking-tight"
                >
                    The home for experiments.
                </p>

                <a
                    href="https://github.com/gksm-labs"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-4 px-10 py-5 rounded-full bg-zinc-900 text-white font-bold text-xl hover:bg-amber-400 hover:text-zinc-900 transition-all duration-300 hover:scale-[1.02] active:scale-95 shadow-2xl shadow-zinc-200"
                >
                    <svg
                        class="w-7 h-7"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        xmlns="http://www.w3.org/2000/svg"
                    >
                        <path
                            d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
                        ></path>
                    </svg>
                    Explore on GitHub
                </a>
            </div>
        </div>
    </main>
</Layout>

<style>
    @keyframes liquid-wobble {
        0%,
        100% {
            transform: translateY(0) rotate(0deg);
        }
        50% {
            transform: translateY(-1px) rotate(1.5deg);
        }
    }
    .animate-liquid {
        animation: liquid-wobble 3s ease-in-out infinite;
        transform-origin: center;
    }

    @keyframes bubble-rise {
        0% {
            transform: translateY(0) scale(0.5);
            opacity: 0;
        }
        15% {
            opacity: 0.9;
            transform: translateY(-2px) scale(1);
        }
        80% {
            opacity: 0.9;
        }
        100% {
            transform: translateY(-13px) scale(1.4);
            opacity: 0;
        }
    }
    .bubble {
        animation: bubble-rise 2s infinite ease-in;
        transform-origin: center;
    }
</style>
