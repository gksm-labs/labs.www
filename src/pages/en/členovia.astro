---
import { members } from "../../data/members";
import Layout from "../../layouts/Layout.astro";

const t = members["en"];
---

<Layout lang="en" title="GKŠM Labs - Members" description="GKŠM Labs – Members">
  <main>
    <section class="mx-auto max-w-6xl py-12">
      <h2 class="mb-10 text-center text-3xl font-semibold tracking-tight">
        Members
      </h2>
      <ul class="grid grid-cols-1 gap-12 sm:grid-cols-2">
        {
          t.map((member) => (
            <li class="flex flex-col items-center text-center">
              <img
                src={member.img}
                alt={member.name}
                class="mb-4 h-28 w-28 rounded-full object-cover"
                width="112"
                height="112"
                loading="lazy"
              />
              <h3 class="mb-1 text-lg font-bold">{member.name}</h3>
              {member.role && (
                <p class="mb-2 text-sm text-zinc-500">{member.role}</p>
              )}
              {member.github && (
                <a
                  href={member.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1 text-sm text-amber-700 hover:underline"
                >
                  <svg
                    class="h-5 w-5"
                    fill="currentColor"
                    aria-hidden="true"
                    viewBox="0 0 24 24"
                  >
                    <path
                      d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.207 11.387.6.113.793-.263.793-.583
                    0-.288-.012-1.238-.014-2.245-3.338.726-4.042-1.415-4.042-1.415-.546-1.387-1.332-1.755-1.332-1.755-1.087-.744.083-.729.083-.729
                    1.205.085 1.841 1.237 1.841 1.237 1.07 1.835 2.809 1.305 3.494.998.108-.775.418-1.305.76-1.606-2.665-.304-5.466-1.333-5.466-5.932
                    0-1.31.468-2.38 1.235-3.22-.123-.303-.535-1.526.117-3.177 0 0 1.008-.322
                    3.3 1.23A11.47 11.47 0 0 1 12 6.844c1.023.005 2.052.138 3.018.403
                    2.291-1.552 3.297-1.23 3.297-1.23.653 1.651.241 2.874.119
                    3.177.77.84 1.234 1.91 1.234 3.22 0 4.61-2.804 5.625-5.475
                    5.921.43.37.823 1.104.823 2.225 0 1.607-.015 2.903-.015
                    3.296 0 .323.192.699.8.581C20.565 21.796 24 17.296 24 12c0-6.63-5.37-12-12-12z"
                    />
                  </svg>
                  GitHub
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </section>
  </main>
</Layout>
