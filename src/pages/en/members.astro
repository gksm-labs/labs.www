---
import Layout from "../../layouts/Layout.astro";
import { translation } from "../../i18n/translation";

const members = translation["en"].members;
---

<Layout lang="en">
  <Fragment slot="head">
    <meta
      name="description"
      content="Members of GKŠM Labs, a student organization at Gymnázium Karola Štúra in Modra. Meet our programmers, designers, and creatives."
    />
    <meta name="author" content="Peter Packa" />
    <meta
      name="keywords"
      content="GKŠM Labs, members, students, Modra, organization, projects, programmers, designers, Gymnázium Karola Štúra, community, IT, activities"
    />
    <meta name="robots" content="index, follow" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content="Members | GKŠM Labs" />
    <meta
      property="og:description"
      content="Members of GKŠM Labs, a student organization at Gymnázium Karola Štúra in Modra. Meet our programmers, designers, and creatives."
    />
    <meta property="og:url" content="https://labs.gksm.sk/en/members" />
    <meta property="og:site_name" content="GKŠM Labs" />
    <meta property="og:locale" content="en_US" />

    <link rel="canonical" href="https://labs.gksm.sk/en/members" />
    <link rel="alternate" href="https://labs.gksm.sk/clenovia" hreflang="sk" />
    <link
      rel="alternate"
      href="https://labs.gksm.sk/en/members"
      hreflang="en"
    />

    <title>Members | GKŠM Labs</title>
  </Fragment>
  <main class="mt-26 min-h-screen">
    <section class="mx-auto max-w-5xl px-4 py-12">
      <h1
        class="mb-10 text-center text-4xl font-black underline decoration-amber-400 decoration-wavy"
      >
        Members
      </h1>
      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {
          members.map((member) => (
            <div class="flex flex-col items-center p-6">
              {member.avatar ? (
                <img
                  src={member.avatar}
                  alt={`Profile picture - ${member.name}`}
                  class="mb-4 h-24 w-24 rounded-full border-2 border-amber-400 object-cover"
                  width="96"
                  height="96"
                  loading="lazy"
                />
              ) : (
                <div class="mb-4 flex h-24 w-24 items-center justify-center rounded-full border-2 border-amber-400 bg-zinc-300 text-2xl font-black text-zinc-500 select-none">
                  <span>{member.name[0]}</span>
                </div>
              )}

              <h3 class="text-lg font-bold text-gray-900">{member.name}</h3>
              <div class="mb-2 font-semibold text-amber-600">
                {member.title}
              </div>

              <div class="mt-4 flex w-full flex-col items-center gap-1.5 text-xs">
                {member.mail && (
                  <a
                    href={`mailto:${member.mail}`}
                    class="flex items-center gap-2 text-amber-500 transition hover:text-amber-600"
                    title="Send e-mail"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="20"
                      height="20"
                      class="h-4 w-4"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7" />
                      <rect x="2" y="4" width="20" height="16" rx="2" />
                    </svg>
                    <span>E-mail</span>
                  </a>
                )}
                {member.phone && (
                  <a
                    href={`tel:${member.phone.replace(/[^+\d]/g, "")}`}
                    class="flex items-center gap-2 text-amber-500 transition hover:text-amber-600"
                    title="Call"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="20"
                      height="20"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="h-4 w-4"
                    >
                      <path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384" />
                    </svg>
                    <span>Phone</span>
                  </a>
                )}
                {member.github && (
                  <a
                    href={
                      member.github.startsWith("http")
                        ? member.github
                        : `https://github.com/${member.github}`
                    }
                    class="flex items-center gap-2 text-amber-500 transition hover:text-amber-600"
                    target="_blank"
                    rel="noopener noreferrer"
                    title="GitHub profile"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="h-5 w-5"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                    >
                      <path d="M12 2C6.477 2 2 6.486 2 12.021c0 4.428 2.867 8.186 6.839 9.525.5.092.682-.217.682-.481 0-.238-.009-.868-.013-1.703-2.782.605-3.369-1.342-3.369-1.342-.454-1.158-1.11-1.467-1.11-1.467-.908-.62.069-.608.069-.608 1 .07 1.528 1.025 1.528 1.025.893 1.531 2.341 1.089 2.91.833.091-.648.35-1.089.636-1.34-2.22-.254-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.254-.447-1.276.098-2.661 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 7.08a9.56 9.56 0 0 1 2.506.338c1.909-1.296 2.748-1.026 2.748-1.026.546 1.385.202 2.407.1 2.661.64.7 1.028 1.595 1.028 2.688 0 3.848-2.338 4.694-4.566 4.943.357.308.678.92.678 1.855 0 1.338-.012 2.419-.012 2.749 0 .267.18.578.688.48C19.134 20.204 22 16.447 22 12.021 22 6.486 17.522 2 12 2z" />
                    </svg>
                    <span>GitHub profile</span>
                  </a>
                )}
                {member.instagram && (
                  <a
                    href={
                      member.instagram.startsWith("http")
                        ? member.instagram
                        : `https://instagram.com/${member.instagram}`
                    }
                    class="flex items-center gap-2 text-amber-500 transition hover:text-amber-600"
                    target="_blank"
                    rel="noopener noreferrer"
                    title="Instagram profile"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="h-4 w-4"
                      width="20"
                      height="20"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                    >
                      <path d="M7 2C4.23858 2 2 4.23858 2 7V17C2 19.7614 4.23858 22 7 22H17C19.7614 22 22 19.7614 22 17V7C22 4.23858 19.7614 2 17 2H7ZM12 7C14.7614 7 17 9.23858 17 12C17 14.7614 14.7614 17 12 17C9.23858 17 7 14.7614 7 12C7 9.23858 9.23858 7 12 7ZM18 6.5C18.2761 6.5 18.5 6.27614 18.5 6C18.5 5.72386 18.2761 5.5 18 5.5C17.7239 5.5 17.5 5.72386 17.5 6C17.5 6.27614 17.7239 6.5 18 6.5ZM12 9C10.3431 9 9 10.3431 9 12C9 13.6569 10.3431 15 12 15C13.6569 15 15 13.6569 15 12C15 10.3431 13.6569 9 12 9Z" />
                    </svg>
                    <span>Instagram</span>
                  </a>
                )}
              </div>
            </div>
          ))
        }
      </div>
    </section>
  </main>
</Layout>
