---
import { getRelativeLocaleUrl } from "astro:i18n";
import LanguageSelector from "./LanguageSelector.astro";
import type { SupportedLang } from "../data/supportedLang";

interface Props {
  lang: SupportedLang;
}

const { lang } = Astro.props;

const translation = {
  sk: {
    navLinks: [
      { label: "Členovia", href: "/členovia" },
      { label: "Projekty", href: "/projekty" },
    ],
  },
  en: {
    navLinks: [
      { label: "Members", href: "/členovia" },
      { label: "Projects", href: "/projekty" },
    ],
  },
};

const pathname = Astro.url.pathname;
const strippedPath = pathname.replace(new RegExp(`^/${lang}(/|$)`), "/") || "/";
---

<header class="sticky top-0 left-0 z-30 bg-white p-6">
  <nav
    class="mx-auto flex w-full max-w-6xl flex-wrap items-center justify-between gap-y-5 md:flex-nowrap"
  >
    <div class="flex w-full items-center md:w-auto">
      <a class="text-2xl font-black" href={getRelativeLocaleUrl(lang, "/")}>
        GKŠM Labs
      </a>

      <button
        id="hamburger"
        type="button"
        aria-label="Open navigation"
        class="ml-auto rounded p-2 focus:outline-none md:hidden"
        aria-controls="mobile-nav"
        aria-expanded="false"
      >
        <svg
          id="hamburger-icon"
          class="h-7 w-7"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M4 8h16M4 16h16"></path>
        </svg>
        <svg
          id="close-icon"
          class="hidden h-7 w-7"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <div class="hidden flex-wrap items-center gap-x-6 gap-y-4 md:flex">
      <ul class="flex items-center gap-6">
        {
          translation[lang].navLinks.map((link) => (
            <li>
              <a
                class="text-xl hover:underline"
                href={getRelativeLocaleUrl(lang, link.href)}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <LanguageSelector lang={lang} />
    </div>

    <div
      id="mobile-nav"
      class="fixed top-16 right-4 z-35 hidden w-60 scale-95 transform flex-col gap-1 rounded-lg border border-zinc-200 bg-white px-4 py-4 text-base font-medium opacity-0 shadow-lg transition-all duration-200 md:hidden"
      tabindex="-1"
      aria-label="Mobile navigation"
    >
      <ul class="mb-4 flex flex-col gap-2">
        {
          translation[lang].navLinks.map((link) => (
            <li>
              <a
                class="block rounded px-2 py-2 text-xl hover:underline"
                href={getRelativeLocaleUrl(lang, link.href)}
                onclick="hideMobileNav()"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <ul class="flex items-center gap-4">
        {
          Object.keys(translation).map((key) => (
            <li>
              <a
                class:list={[
                  Astro.currentLocale === key
                    ? "cursor-default text-amber-600"
                    : "text-zinc-700 hover:underline",
                ]}
                href={
                  Astro.currentLocale === key
                    ? undefined
                    : getRelativeLocaleUrl(key, strippedPath)
                }
              >
                {key}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <script is:inline>
      let isNavOpen = false;
      const hamburger = document.getElementById("hamburger");
      const mobileNav = document.getElementById("mobile-nav");
      const hamburgerIcon = document.getElementById("hamburger-icon");
      const closeIcon = document.getElementById("close-icon");

      function setNav(open) {
        isNavOpen = open;

        mobileNav.classList.toggle("hidden", !isNavOpen);
        setTimeout(
          () => {
            mobileNav.style.opacity = isNavOpen ? "1" : "0";
            mobileNav.style.transform = isNavOpen ? "scale(1)" : "scale(0.95)";
          },
          isNavOpen ? 10 : 0,
        );

        hamburger.setAttribute("aria-expanded", isNavOpen ? "true" : "false");
        hamburgerIcon.classList.toggle("hidden", isNavOpen);
        closeIcon.classList.toggle("hidden", !isNavOpen);

        if (isNavOpen) {
          setTimeout(() => mobileNav.focus(), 100);
        }
      }
      hamburger &&
        hamburger.addEventListener("click", () => setNav(!isNavOpen));
      window.hideMobileNav = () => setNav(false);

      window.addEventListener("keydown", (e) => {
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === "k") {
          e.preventDefault();
          setNav(!isNavOpen);
        }

        if (isNavOpen && (e.key === "Escape" || e.key === "Esc")) {
          setNav(false);
        }
      });

      window.addEventListener("resize", () => {
        if (window.innerWidth >= 768 && isNavOpen) {
          setNav(false);
        }
      });

      document.addEventListener("click", (e) => {
        if (
          isNavOpen &&
          !mobileNav.contains(e.target) &&
          !hamburger.contains(e.target)
        ) {
          setNav(false);
        }
      });
    </script>
  </nav>
</header>
