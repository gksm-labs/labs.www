---
import { getRelativeLocaleUrl } from "astro:i18n";
import type { SupportedLang } from "../data/supportedLang";

interface Props {
  lang: SupportedLang;
}

const { lang } = Astro.props;

const LANGUAGES: Record<
  SupportedLang,
  {
    label: string;
    modalLabel: string;
    closeLabel: string;
    triggerLabel: string;
  }
> = {
  sk: {
    label: "Slovenčina",
    modalLabel: "Vybrať jazyk",
    closeLabel: "Zavrieť",
    triggerLabel: "Zmeniť jazyk",
  },
  en: {
    label: "English",
    modalLabel: "Select Language",
    closeLabel: "Close",
    triggerLabel: "Change language",
  },
};

const pathname = Astro.url.pathname;
const strippedPath = pathname.replace(new RegExp(`^/${lang}(/|$)`), "/") || "/";
---

<div class="fixed top-3 right-3 z-30">
  <button
    id="lang-trigger"
    type="button"
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-controls="lang-modal-wrapper"
    aria-label={LANGUAGES[lang].triggerLabel}
    class="inline-flex cursor-pointer items-center gap-3 rounded-full bg-neutral-200 px-6 py-3 text-xl font-bold text-zinc-900 shadow-lg transition-all duration-300 hover:scale-[1.02] hover:bg-amber-400 active:scale-95"
  >
    {LANGUAGES[lang].triggerLabel}
    <svg
      aria-hidden="true"
      focusable="false"
      class="h-4 w-4 opacity-50"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="2.5"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"
      ></path>
    </svg>
  </button>
</div>

<div
  id="lang-backdrop"
  aria-hidden="true"
  class="pointer-events-none fixed inset-0 z-40 bg-zinc-900/60 opacity-0 backdrop-blur-sm transition-opacity duration-300"
>
</div>

<div
  id="lang-modal-wrapper"
  role="dialog"
  aria-modal="true"
  aria-labelledby="lang-modal-title"
  class="pointer-events-none fixed inset-0 z-50 flex scale-95 items-center justify-center px-4 opacity-0 transition-all duration-300"
>
  <div
    id="lang-modal"
    class="flex w-full max-w-[320px] flex-col gap-4 rounded-3xl border border-white/20 bg-neutral-100 p-6 shadow-2xl"
  >
    <div class="flex items-center justify-between">
      <h2
        id="lang-modal-title"
        class="text-xs font-bold tracking-widest text-zinc-500 uppercase"
      >
        {LANGUAGES[lang].modalLabel}
      </h2>
      <button
        id="lang-close"
        type="button"
        aria-label={LANGUAGES[lang].closeLabel}
        class="cursor-pointer rounded-full p-1 text-zinc-400 transition-colors hover:bg-zinc-200 hover:text-zinc-900"
      >
        <svg
          aria-hidden="true"
          focusable="false"
          class="h-6 w-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <nav aria-label={LANGUAGES[lang].modalLabel}>
      <ul class="space-y-2">
        {
          Object.entries(LANGUAGES).map(([code, { label }]) => {
            const isCurrent = code === lang;
            const targetUrl = getRelativeLocaleUrl(
              code as SupportedLang,
              strippedPath,
            );

            return (
              <li>
                <a
                  href={isCurrent ? undefined : targetUrl}
                  aria-current={isCurrent ? "page" : undefined}
                  lang={code}
                  class:list={[
                    "group flex items-center justify-between gap-4 rounded-2xl px-5 py-4 text-lg font-bold transition-all duration-200",
                    isCurrent
                      ? "cursor-default bg-amber-400 text-zinc-900"
                      : "border border-zinc-200 bg-white text-zinc-700 shadow-sm hover:bg-amber-100 hover:text-zinc-900",
                  ]}
                >
                  {label}
                  {isCurrent ? (
                    <svg
                      aria-hidden="true"
                      class="h-5 w-5"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="3"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M5 13l4 4L19 7"
                      />
                    </svg>
                  ) : (
                    <span class="text-amber-500 opacity-0 transition-opacity group-hover:opacity-100">
                      →
                    </span>
                  )}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</div>

<script>
  function setupLangSwitcher() {
    const trigger = document.getElementById("lang-trigger");
    const backdrop = document.getElementById("lang-backdrop");
    const modalWrapper = document.getElementById("lang-modal-wrapper");
    const modal = document.getElementById("lang-modal");
    const close = document.getElementById("lang-close");

    if (!trigger || !modalWrapper) return;

    function toggleModal(isOpen: boolean) {
      if (isOpen) {
        backdrop?.classList.remove("opacity-0", "pointer-events-none");
        modalWrapper?.classList.remove(
          "opacity-0",
          "pointer-events-none",
          "scale-95",
        );
        modalWrapper?.classList.add("scale-100");
        trigger?.setAttribute("aria-expanded", "true");
        close?.focus();
        document.body.style.overflow = "hidden";
      } else {
        backdrop?.classList.add("opacity-0", "pointer-events-none");
        modalWrapper?.classList.add(
          "opacity-0",
          "pointer-events-none",
          "scale-95",
        );
        modalWrapper?.classList.remove("scale-100");
        trigger?.setAttribute("aria-expanded", "false");
        trigger?.focus();
        document.body.style.overflow = "";
      }
    }

    trigger.addEventListener("click", () => toggleModal(true));
    close?.addEventListener("click", () => toggleModal(false));
    backdrop?.addEventListener("click", () => toggleModal(false));

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !modalWrapper.classList.contains("opacity-0")) {
        toggleModal(false);
      }
    });

    modalWrapper.addEventListener("click", (e) => {
      if (e.target === modalWrapper) toggleModal(false);
    });
  }

  setupLangSwitcher();

  document.addEventListener("astro:after-swap", setupLangSwitcher);
</script>
