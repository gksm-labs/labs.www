---
import "../styles/global.css";
---

<!doctype html>
<html lang="sk">
    <head>
        <meta charset="UTF-8" />
        <meta
            name="description"
            content="GKŠM Labs - We share student projects, coding experiments, and research work."
        />
        <meta name="viewport" content="width=device-width" />
        <title>GKŠM Labs</title>

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap"
            rel="stylesheet"
        />
    </head>
    <body
        class="bg-zinc-950 text-zinc-50 font-sans antialiased selection:bg-emerald-500 selection:text-white"
    >
        <slot />
    </body>
</html>

<style is:global>
    :root {
        --font-space: "Space Grotesk", sans-serif;
    }
    body {
        font-family: var(--font-space);
    }

    ::-webkit-scrollbar {
        width: 10px;
    }
    ::-webkit-scrollbar-track {
        background: #09090b;
    }
    ::-webkit-scrollbar-thumb {
        background: #27272a;
        border-radius: 5px;
    }
    ::-webkit-scrollbar-thumb:hover {
        background: #3f3f46;
    }
</style>
